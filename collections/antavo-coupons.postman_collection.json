          "request": {
            "name": "Query coupons independent of customer",
            "description": {
              "content": "Use this endpoint to query coupons within Antavo independently of customer data. \nThis allows searching for coupons based on criteria such as coupon code and status, providing flexibility in managing coupon data.\n",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "coupons"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "code",
                  "value": "<string>",
                  "description": "The code used to search for a specific coupon."
                },
                {
                  "disabled": false,
                  "key": "status",
                  "value": "<string>",
                  "description": "The status of the coupons to search for. \nOptions: <code>claimed</code>, <code>redeemed</code>, <code>invalid</code>, <code>expired</code>, <code>unassigned</code>, <code>partially_redeemed</code>"
                },
                {
                  "disabled": false,
                  "key": "limit",
                  "value": "100",
                  "description": "Limits the number of results to be returned in one response.\n"
                },
                {
                  "disabled": false,
                  "key": "page",
                  "value": "0",
                  "description": "This parameter gets a specific page of the coupon list if a limit has been set. This is used in pagination in conjunction with the limit query.\t\n"
                }
              ],
              "variable": []
            },
