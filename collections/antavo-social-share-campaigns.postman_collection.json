          "id": "d3336da4-cdde-49a0-8918-f0d9c4c3cdfd",
          "name": "Submit a share intent",
          "request": {
            "name": "Submit a share intent",
            "description": {
              "content": "This API endpoint registers a customer’s intent to share content for an active campaign configured in the [Social Share Campaigns module](https://docs.antavo.com/docs/social-share-campaigns). Triggers the `share_intent_success` [event](https://developers.antavo.com/docs/internal-events#/share_intent_success) when a campaign match occurs.\nCall this endpoint when a customer clicks a share button on a content page. Include the customer ID, target platform, and URL to be shared.\n",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "v1",
                "social-share-campaigns",
                "share-intent"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": []
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "POST",
            "auth": null,
            "body": {
              "mode": "raw",
              "raw": "{\n  \"customer_id\": \"<string>\",\n  \"url\": \"<string>\",\n  \"platform\": \"<string>\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": [
            {
              "id": "b5a77a5f-11d3-4e37-934a-f0d919e4b7f8",
              "name": "Share intent submitted. This response may be retured when the intent request is successfully validated, but a parameter value is invalid or missing.",
