                    "value": "application/json"
                  }
                ],
                "method": "POST",
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"cart\": {\n    \"total\": 22.22,\n    \"items\": [\n      {\n        \"product_id\": \"prd_987654\",\n        \"quantity\": 2,\n        \"price\": 10,\n        \"discount\": 1,\n        \"subtotal\": 18\n      },\n      {\n        \"product_id\": \"prd_987654\",\n        \"quantity\": 2,\n        \"price\": 10,\n        \"discount\": 1,\n        \"subtotal\": 18\n      }\n    ],\n    \"discount\": 2.22,\n    \"shipping\": 4.44\n  },\n  \"customer\": \"9f3c82d6-288e-4361-aec0-039eb066a334\",\n  \"store\": \"3044\",\n  \"eligible_only\": true\n}",
                  "options": {
